{
  "info": {
    "name": "E-Commerce Cloud-Native Microservices",
    "description": "Automated Postman Collection with zero copy-paste token extraction and multi-EC2 instance variable support.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "customerToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "productId",
      "value": "PROD-101"
    },
    {
      "key": "reviewId",
      "value": ""
    },
    {
      "key": "notificationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health & Load Balancer Verification",
      "item": [
        {
          "name": "Nginx Health Check (EC2 #1, Port 80)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://{{ec2_gateway_ip}}:{{ec2_gateway_port}}/nginx-health",
              "host": [
                "{{ec2_gateway_ip}}"
              ],
              "path": [
                "nginx-health"
              ],
              "port": "{{ec2_gateway_port}}"
            }
          }
        },
        {
          "name": "API Gateway Health Check (Port 8000)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "Review Load Balancer Test (Alternates Instances)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/reviews/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "reviews",
                "health"
              ]
            }
          }
        },
        {
          "name": "Product Load Balancer Test (Alternates Instances)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/products/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "products",
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Authentication Service (Auto Token Saving)",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@store.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"Customer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login Customer (Auto-Saves customerToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.environment.set('customerToken', data.token);",
                  "    pm.collectionVariables.set('customerToken', data.token);",
                  "    console.log('Customer token captured:', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@store.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Register Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@store.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"Admin\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login Admin (Auto-Saves adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var data = pm.response.json();",
                  "    pm.environment.set('adminToken', data.token);",
                  "    pm.collectionVariables.set('adminToken', data.token);",
                  "    console.log('Admin token captured:', data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@store.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
