# ========================================================
# Root Environment Configuration (Docker Compose)
# ========================================================

# --------------------------------------------------------
# 1. MongoDB Connection
# --------------------------------------------------------
# Option A: MongoDB Atlas (Cloud Hosted)
# Set your cluster URI base (without the /dbname):
MONGODB_URI_BASE=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net

# Option B: Local Docker Mongo Container (Default if MONGODB_URI_BASE is blank)
# Leaves it defaulting to mongodb://mongo:27017/<dbname>

# --------------------------------------------------------
# 2. Security
# --------------------------------------------------------
# Shared Secret Key used to sign and verify JWT tokens
JWT_SECRET=supersecretkey123
