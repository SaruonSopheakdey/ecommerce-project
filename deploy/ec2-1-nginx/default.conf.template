upstream api_gateway_cluster {
    server ${EC2_2_PRIVATE_IP}:8000 max_fails=3 fail_timeout=10s;
    server ${EC2_3_PRIVATE_IP}:8000 max_fails=3 fail_timeout=10s;
}

server {
    listen 80;
    server_name localhost;

    # Verification headers
    add_header X-Load-Balancer "Nginx-EC2-1" always;
    add_header X-Upstream-Server $upstream_addr always;

    # Nginx Edge Health Endpoint
    location = /nginx-health {
        default_type application/json;
        return 200 '{"status":"UP","service":"nginx-edge","node":"ec2-1-nginx","gateways":["${EC2_2_PRIVATE_IP}:8000","${EC2_3_PRIVATE_IP}:8000"]}';
    }

    # Round-Robin Load Balance & Failover across Gateway Replicas (EC2 #2 & EC2 #3)
    location / {
        proxy_pass http://api_gateway_cluster;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
