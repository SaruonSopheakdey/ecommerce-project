# ========================================================
# EC2 #4 Environment Configuration (Core Services)
# ========================================================

# --------------------------------------------------------
# 1. MongoDB Atlas Cloud Connection
# --------------------------------------------------------
# Paste your MongoDB Atlas base cluster URI (WITHOUT /dbname at the end):
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net
MONGODB_URI_BASE=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net

# --------------------------------------------------------
# 2. Security (JWT Secret for Token Signing)
# --------------------------------------------------------
# MUST match the JWT_SECRET configured on EC2 #2 and EC2 #3
JWT_SECRET=supersecretkey123
